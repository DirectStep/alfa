# Только для локальной разработки. Скопируйте в .env.local и не коммитьте его.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
API_PORT=3011

# На GitHub Pages укажите полный URL функции или API Gateway endpoint.
# Локально оставьте пустым: Next.js проксирует /api/chat на порт 3011.
NEXT_PUBLIC_CHAT_API_URL=
# Необязательно. Для прямой Yandex Cloud Function healthcheck использует тот же URL.
# Нужна только если проверка здоровья опубликована по отдельному адресу.
NEXT_PUBLIC_HEALTH_API_URL=
